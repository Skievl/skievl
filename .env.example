# Copy to .env.local for development. In production set these in Vercel →
# Project → Settings → Environment Variables. Never commit real values.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers → API keys (use test keys until launch)
STRIPE_SECRET_KEY=sk_test_...
# Webhook endpoint for platform events ("Your account")
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook endpoint for connected-account events ("Connected accounts")
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Resend — transactional email. Domain skievl.com must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Ellicottville Ski Exchange <orders@skievl.com>"
# Where admin alerts (disputes, reports) are sent
ADMIN_ALERT_EMAIL=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Optional analytics: Google Analytics 4 measurement ID (G-XXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=
